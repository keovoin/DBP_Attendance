# ---- Telegram Attendance Tracker configuration ----

# REQUIRED: Bot token from @BotFather on Telegram
BOT_TOKEN=123456:ABC-your-bot-token-here

# Path to the SQLite database file (created automatically if missing)
DB_PATH=data/attendance.db

# Comma-separated list of Telegram user IDs that are granted the Admin role
# automatically on registration. Use this to bootstrap the first Admin, since
# the /promote command itself requires Admin access.
# Find your numeric id by messaging @userinfobot on Telegram.
ADMIN_TELEGRAM_IDS=

# Timezone offset in hours from UTC used for timestamps and "current date"
# logic. Default is 7 = Cambodia / Indochina Time (ICT, UTC+7).
# Other examples: 0 for UTC, -5 for US Eastern.
TZ_OFFSET_HOURS=7

# Geofence radius in meters for On_Site clock-in validation.
# Members must be within this many meters of the configured location.
GEOFENCE_RADIUS_METERS=100

# Long-polling timeout in seconds for getUpdates.
POLL_TIMEOUT_SECONDS=30

# ---- Admin web dashboard (optional) ----
# Set a password to enable the browser-based admin dashboard. If left empty,
# only a minimal health endpoint is served (no dashboard). On Fly.io set this
# with `fly secrets set ADMIN_PORTAL_PASSWORD=...`, never commit it.
ADMIN_PORTAL_PASSWORD=

# Secret used to sign dashboard login cookies. Optional: defaults to BOT_TOKEN.
PORTAL_SECRET=

# Port the web/health server listens on (matches internal_port in fly.toml).
PORT=8080
